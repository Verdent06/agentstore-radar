{
  "name": "@agentstore-radar/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP server for AgentStore Radar public aggregates.",
  "bin": {
    "agentstore-radar-mcp": "./dist/stdio.js"
  },
  "files": [
    "src",
    "Dockerfile",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "start": "tsx src/http.ts",
    "start:stdio": "tsx src/stdio.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/tools.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
